<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. This uses AppCompat with no ActionBar to support per-app language settings and Compose. -->
    <style name="Theme.BrewLog" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Starting theme for the Splash Screen API. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.BrewLog</item>
    </style>
</resources>